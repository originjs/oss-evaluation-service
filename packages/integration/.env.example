# integration 环境变量示例（只适用于 integration）
# 部署 integration 时，把下面这些变量设置到 integration 容器里即可。
# 镜像不会把 .env 打进去；生产可以直接设置容器环境变量。

# ============================================================
# 必填：数据库
# ============================================================

# 主 MySQL 连接地址。
# 格式：mysql://用户名:密码@数据库主机:3306/数据库名
DATABASE_URL=mysql://oss_eval_user:change_me@mysql-host.example.com:3306/oss-eval

# ============================================================
# 常用：服务启动方式
# ============================================================

# integration 容器内部监听端口。
PORT=3001

# 开发/冒烟测试建议 development；正式跑定时任务才用 production。
NODE_ENV=development

# 只要这个变量不是空，定时任务就不会启动。
# 如果要正式跑定时任务：NODE_ENV=production，并把这里留空。
DISABLE_SCHEDULE_JOB=true

# 日志目录。
LOG_DIR=logs

# ============================================================
# 平台 Token
# ============================================================

# 必须是 JSON 数组字符串。没有 token 就写 []。
GITHUB_TOKEN=[]
GITEE_TOKEN=[]
GITCODE_TOKEN=[]

# ============================================================
# 可选：扩展数据库 / AI / repo-service
# 不用这些能力就保持空。
# ============================================================

DATABASE_EXT_URL=
COZE_API_TOKEN=
EXT_AI_SERVICE_URL=
EXT_ALTERNATIVE_BOT=
EXT_PROJECT_DESCRIPTION_BOT=
REPO_SERVICE_URL=
