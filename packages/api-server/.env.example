# api-server 环境变量示例（只适用于 api-server）
# 部署 api-server 时，把这些变量设置到 api-server 容器里。

# 必填：主 MySQL 连接地址。
DATABASE_URL=mysql://oss_eval_user:change_me@mysql-host.example.com:3306/oss-eval

# api-server 容器内部监听端口。
PORT=3000

# 运行模式。production 会影响部分业务命名逻辑。
NODE_ENV=development

# 日志目录。
LOG_DIR=logs

# 上传文件目录，benchmark 文件会写到这里。
UPLOAD_PATH=/root/upload

# 可选：integration 服务地址。只有需要调用 integration 的 benchmark 同步路径时才配置。
INTEGRATION_URL=

# 可选：请求 integration 时使用的代理地址。
PROXY_URL=

# 可选：AI 分类服务配置。不使用 AI 分类就保持空。
API_TSC=
APIKEY_TSC=
API_TSC_LIMIT=2

# 可选：第二个数据库连接。不使用就保持空。
DATABASE_EXT_URL=
