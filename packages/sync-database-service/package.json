{
  "name": "@originjs/sync-service",
  "version": "1.0.0",
  "private": false,
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev:download-server": "PORT=13015 build & nodemon",
    "dev:command-server": "pnpm run build & nodemon",
    "tsc": "vue-tsc --noEmit",
    "build": "tsoa spec-and-routes && tsc",
    "start": "node ./dist/app.js",
    "swagger": "tsoa spec-and-routes",
    "test": "vitest run"
  },
  "nodemonConfig": {
    "watch": [
      "src"
    ],
    "ext": "ts",
    "exec": "tsc && node ./dist/app.js"
  },
  "dependencies": {
    "@orginjs/oss-evaluation-util": "workspace:^",
    "@tsoa/runtime": "^6.2.0",
    "axios": "^1.6.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.1",
    "express": "^4.16.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.4.0",
    "morgan": "^1.9.1",
    "mysql2": "^3.11.3",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.2",
    "sequelize": "^6.37.3",
    "shelljs": "^0.8.5",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.2.0",
    "winston": "^3.13.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^18.11.12",
    "@types/pino": "^7.0.5",
    "@types/sequelize": "^4.28.20",
    "@types/shelljs": "^0.8.15",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/underscore": "^1.11.15",
    "nodemon": "^3.0.3"
  }
}
