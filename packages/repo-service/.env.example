# repo-service 环境变量示例（只适用于 repo-service）
# 部署 repo-service 时，把这些变量设置到 repo-service 容器里。

# 必填：主 MySQL 连接地址。
DATABASE_URL=mysql://oss_eval_user:change_me@mysql-host.example.com:3306/oss-eval

# repo-service 容器内部监听端口。
PORT=3002

# 运行模式。
NODE_ENV=development

# 日志目录。
LOG_DIR=logs

# 必填：临时克隆仓库的目录。
REPO_DIR=/tmp/oss-evaluation-repos

# 平台 Token。必须是 JSON 数组字符串；没有 token 就写 []。
GITHUB_TOKEN=[]
GITEE_TOKEN=[]
GITCODE_TOKEN=[]

# 可选：第二个数据库连接。不使用就保持空。
DATABASE_EXT_URL=
