# ============================================================
# OSS Evaluation Service — Environment Variables
# Copy this file to .env and fill in the values
# ============================================================

# --- Database ---
# Docker: mysql://root:oss-eval-root@127.0.0.1:3306/oss-eval
DATABASE_URL=mysql://root:oss-eval-root@127.0.0.1:3306/oss-eval
DATABASE_EXT_URL=mysql://root:oss-eval-root@127.0.0.1:3306/oss-eval-inner

# --- Server Ports ---
PORT=3000
# INTEGRATION_URL=http://localhost:3001

# --- GitHub ---
# GITHUB_TOKEN=ghp_xxxxxxxxxxxx
# GITHUB_AUTH_TOKEN=ghp_xxxxxxxxxxxx

# --- AI / Coze ---
# COZE_API_TOKEN=
# EXT_AI_SERVICE_URL=
# EXT_ALTERNATIVE_BOT=
# EXT_PROJECT_DESCRIPTION_BOT=

# --- AI Tech Stack Classification ---
# API_TSC=
# APIKEY_TSC=
# API_TSC_LIMIT=2

# --- Misc ---
NODE_ENV=development
# PROXY_URL=
# LOG_DIR=logs
# UPLOAD_PATH=/tmp/upload
