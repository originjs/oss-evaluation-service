# ============================================================
# OSS Evaluation Service 根目录环境变量示例
#
# 这个文件是“全仓库 / docker compose 部署参考”。
# 单独部署某个服务时，优先看对应服务目录里的 .env.example：
# - packages/integration/.env.example
# - packages/api-server/.env.example
# - packages/repo-service/.env.example
# - packages/landscape/.env.example
#
# 根目录文件使用带服务名前缀的变量，避免多个服务都叫 PORT 时冲突。
# ============================================================

# ============================================================
# 公共数据库配置
# ============================================================

DATABASE_URL=mysql://oss_eval_user:change_me@mysql-host.example.com:3306/oss-eval
DATABASE_EXT_URL=
LOG_DIR=logs
NODE_ENV=development

# ============================================================
# integration
# ============================================================

INTEGRATION_PORT=3001
DISABLE_SCHEDULE_JOB=true

# 必须是 JSON 数组字符串。没有 token 就写 []。
GITHUB_TOKEN=[]
GITEE_TOKEN=[]
GITCODE_TOKEN=[]

COZE_API_TOKEN=
EXT_AI_SERVICE_URL=
EXT_ALTERNATIVE_BOT=
EXT_PROJECT_DESCRIPTION_BOT=
REPO_SERVICE_URL=

# ============================================================
# api-server
# ============================================================

API_SERVER_PORT=3000
UPLOAD_PATH=/app/upload
# compose 内部默认指向 integration 容器,单独部署时改为实际地址
INTEGRATION_URL=http://integration:3001
PROXY_URL=
API_TSC=
APIKEY_TSC=
API_TSC_LIMIT=2

# ============================================================
# website
# ============================================================

WEBSITE_PORT=8080
# 前端构建期注入的后端 API 基础路径,默认走 nginx 反向代理
VITE_BACKEND_SERVICE_URL=/oss-evaluation-api

# ============================================================
# repo-service
# ============================================================

REPO_SERVICE_PORT=3002
REPO_DIR=/tmp/oss-evaluation-repos

# ============================================================
# local MySQL（只在 docker compose --profile local-mysql 时使用）
# ============================================================

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=oss-eval-root
MYSQL_DATABASE=oss-eval
