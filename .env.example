# ============================================================
# OSS Evaluation Service — Docker production deployment env
# Copy to .env, then edit DATABASE_URL before running compose:
#   cp .env.example .env
# ============================================================

# --- Integration container ---
INTEGRATION_PORT=3001

# Production: point this to the existing physical-machine MySQL.
# Format:
#   mysql://USER:PASSWORD@MYSQL_HOST:3306/DATABASE_NAME
DATABASE_URL=mysql://oss_eval_user:change_me@mysql-host.example.com:3306/oss-eval

# Set true for smoke tests / manual API usage.
# Production scheduled jobs: NODE_ENV=production and DISABLE_SCHEDULE_JOB=
NODE_ENV=development
DISABLE_SCHEDULE_JOB=true

# Optional second database connection used only by code paths that read DATABASE_EXT_URL.
DATABASE_EXT_URL=

# Log directory inside the integration container.
LOG_DIR=logs

# --- Platform API tokens ---
# Must be JSON array strings because integration calls JSON.parse().
# GITHUB_TOKEN supports ordered primary -> backup rotation; GitHub code validates in order and caches the first valid token.
# GITEE_TOKEN / GITCODE_TOKEN keep the existing integration behavior.
GITHUB_TOKEN=[]
GITEE_TOKEN=[]
GITCODE_TOKEN=[]

# --- Optional AI integrations ---
# COZE_API_TOKEN is only used by /sync/alternative and /sync/aiClassification when EXT_AI_SERVICE_URL is not set.
COZE_API_TOKEN=
# If EXT_AI_SERVICE_URL is set, /sync/alternative and /sync/projectDescription send POST requests to that external AI service.
EXT_AI_SERVICE_URL=
# Bearer tokens / bot identifiers sent to EXT_AI_SERVICE_URL for the two AI routes above.
EXT_ALTERNATIVE_BOT=
EXT_PROJECT_DESCRIPTION_BOT=

# Optional repo-service fallback for code size calculation.
# Leave empty unless repo-service is deployed separately.
REPO_SERVICE_URL=

# --- Local test MySQL only ---
# Used only when running:
#   docker compose --profile local-mysql up -d mysql
MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=oss-eval-root
MYSQL_DATABASE=oss-eval
